# Copy this file to ".env" (and to ".env.test" for the test database) and fill in your own values.
# NEVER commit .env or .env.test. Only this example file is committed.

# PostgreSQL connection string (SECRET in production - stored in Secret Manager in Lab 5).
# Local Docker Compose default:
DATABASE_URL="postgresql://lendlab:lendlab@localhost:5432/lendlab?schema=public"
# In .env.test use the separate test database instead:
# DATABASE_URL="postgresql://lendlab:lendlab@localhost:5432/lendlab_test?schema=public"

# HTTP port for the API (Cloud Run sets this automatically in production).
PORT=3000

# development | test | production
NODE_ENV=development

# Session lifetime in hours (NFR-04).
SESSION_TTL_HOURS=8

# Browser origin allowed to call the API during local development (Vite dev server).
CORS_ORIGIN="http://localhost:5173"

# Full commit SHA of the running release. Set by the deploy pipeline on Cloud Run
# and shown by GET /api/health (R-08). Leave empty locally (reports "local").
GIT_SHA=""

# Password given to every seeded demo account (SECRET - choose your own, never commit it).
# Must be at least 8 characters. Required by "npm run db:seed".
DEMO_USER_PASSWORD="change-me-locally"
