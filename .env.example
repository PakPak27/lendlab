# Settings for `docker compose up --build` (copy to ".env"; never commit .env).
# The app's own variables are documented in server/.env.example and
# docs/labs/lab05/deployment.md.

# Password for every seeded demo account (SECRET - choose your own, 8+ characters).
DEMO_USER_PASSWORD=""

# Host ports. Change them if 5432 or 3000 is already used on your machine.
DB_PORT=5432
APP_PORT=3000
